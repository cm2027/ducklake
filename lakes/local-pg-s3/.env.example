# Optional overrides only you do NOT need a `.env` file.
# compose.yaml, the garage-init scripts, seed.sql and the client examples all
# fall back to these same hardcoded dev defaults when the env vars are unset.
# Copy to `.env` (or export the vars) only to change a value.
# All values below are PUBLIC DEV DEFAULTS, not for prod use.
POSTGRES_USER=ducklake
POSTGRES_PASSWORD=ducklake
POSTGRES_DB=ducklake_catalog
POSTGRES_PORT=5432

# Garage (S3-compatible store). Generate a fresh one for real use:
#   openssl rand -hex 32
GARAGE_RPC_SECRET=1799bccfd7411eddcf9ebd316bc1f5287ad12a68094e1c6ac6abde7e6feae1ec
GARAGE_S3_PORT=3900
GARAGE_RPC_PORT=3901
GARAGE_WEB_PORT=3902
GARAGE_REGION=garage

# S3 bucket + credentials for the lake data.
# garage-init.sh imports this key (deterministic, so seeding needs no parsing).
# Key ID must be `GK` + 24 hex chars, secret must be 64 hex chars (Garage format).
# THESE ARE PUBLIC DEV DEFAULTS, generate fresh ones for anything real.
S3_BUCKET=ducklake-data
S3_KEY_ID=GK0123456789abcdef01234567
S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
